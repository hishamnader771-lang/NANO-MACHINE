.github/workflows/build.yml
name: Build NANO MACHINE APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'NANO_MACHINE_cloud_build.zip'
      - '.github/workflows/build.yml'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Extract project
        run: unzip -o NANO_MACHINE_cloud_build.zip -d .

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        run: gradle assembleDebug

      - name: Save APK
        uses: actions/upload-artifact@v4
        with:
          name: NANO-MACHINE-APK
          path: app/build/outputs/apk/debug/app-debug.apk
